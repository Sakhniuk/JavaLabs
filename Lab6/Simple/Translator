import java.util.HashMap;
import java.util.Map;
class Translator {
    private HashMap<String, String> dictionary;

    public Translator() {
        this.dictionary = new HashMap<>();
    }

    public void addWord(String english, String ukrainian) {
        if (english == null || ukrainian == null
                || english.trim().isEmpty() || ukrainian.trim().isEmpty()) {
            System.out.println("Помилка: слова не можуть бути порожніми");
            return;
        }
        dictionary.put(english.trim().toLowerCase(), ukrainian.trim());
    }

    public String translate(String phrase) {
        if (phrase == null || phrase.trim().isEmpty()) {
            return "";
        }

        String[] words = phrase.trim().split("\\s+");
        StringBuilder result = new StringBuilder();

        for (int i = 0; i < words.length; i++) {
            String word = words[i];
            String cleanWord = word.replaceAll("[^a-zA-Z']", "").toLowerCase();
            String punctuation = word.replaceAll("[a-zA-Z']", "");

            String translation = dictionary.get(cleanWord);

            if (translation != null) {
                result.append(translation);
            } else {
                result.append("[").append(word).append("]");
                punctuation = "";
            }

            result.append(punctuation);

            if (i < words.length - 1) {
                result.append(" ");
            }
        }

        return result.toString();
    }

    public int size() {
        return dictionary.size();
    }

    public void printDictionary() {
        if (dictionary.isEmpty()) {
            System.out.println("Словник порожній.");
            return;
        }
        System.out.println(" Поточний словник ");
        for (Map.Entry<String, String> entry : dictionary.entrySet()) {
            System.out.println(entry.getKey() + " -> " + entry.getValue());
        }
    }
}
